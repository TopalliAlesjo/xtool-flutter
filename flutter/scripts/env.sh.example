# shellcheck shell=bash
# xtool-flutter lab environment. Copy to "$XTOOL_FLUTTER_LAB/env.sh" and `source` it
# in every WSL shell you use for building or installing. Nothing here touches your
# shell profile or system-wide SDKs.
#
#   cp flutter/scripts/env.sh.example ~/xtool-flutter-lab/env.sh

export XTOOL_FLUTTER_LAB="${XTOOL_FLUTTER_LAB:-$HOME/xtool-flutter-lab}"
lab="$XTOOL_FLUTTER_LAB"

# Swift toolchain from swift.org (tested: 6.4.0; xtool 1.24.0 targets 6.4.1).
swift_bin="$lab/toolchains/swift/usr/bin"

# LLVM Mach-O binutils (llvm-lipo, llvm-otool, llvm-install-name-tool) from Ubuntu's llvm-18.
llvm_bin=/usr/lib/llvm-18/bin

# xtool built from this repository (swift build --configuration release).
xtool_bin="$lab/xtool/.build/release"

# Pinned libimobiledevice stack built by flutter/scripts/build-native-deps.sh.
native="$lab/native"

# Flutter SDK for Linux, pinned to the version your app uses.
flutter_bin="$lab/toolchains/flutter/bin"

export PATH="$xtool_bin:$swift_bin:$llvm_bin:$native/bin:$flutter_bin:$PATH"
export PKG_CONFIG_PATH="$native/lib/pkgconfig:$native/lib64/pkgconfig"
export LD_LIBRARY_PATH="$native/lib:$native/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

export CI=true FLUTTER_SUPPRESS_ANALYTICS=true DART_SUPPRESS_ANALYTICS=true

# Set this after starting flutter/windows/usbmuxd-relay.py so xtool talks to the
# Windows Apple Mobile Device Service instead of a USB/IP-attached device.
# export USBMUXD_SOCKET_ADDRESS="UNIX:$lab/runtime/windows-usbmuxd.sock"

unset lab swift_bin llvm_bin xtool_bin native flutter_bin
